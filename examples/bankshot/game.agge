tilemap table {"cell":16,"tiles":{"#":[[48,78,111,255],true],"o":[[37,57,87,255]]},"rows":["####################","#..................#","#..................#","#..o...o...o...o...#","#..................#","#..................#","#..o...o...o...o...#","#..................#","#..................#","#..o...o...o...o...#","#..................#","####################","...................."]}
script ball
create:
  set aim = 180
  set age = 0
  global aim = aim
step:
  if age > 0
    set age = age - 1
    if age == 0
      set x = 60
      set y = 144
      set vx = 0
      set vy = 0
    end
  else
    set aim = clamp(aim + (down("right") - down("left")) * 90 * dt, -240, 240)
    global aim = floor(aim)
    if pressed("fire") && global(shots) < 3
      global shots = global(shots) + 1
      set vx = aim
      set vy = -180
      set age = 150
    end
  end
hit_x:
  set vx = -impact()
  emit spark
hit_y:
  set vy = -impact()
  emit spark
---
script controller
create:
  global relays = 0
  global shots = 0
  set finish = 22
  set age = 0
step:
  if pressed("reset")
    goto table
  end
  if global(relays) == 3
    set finish = finish - 1
    if finish == 0
      goto clear
    end
  else
    if global(shots) == 3
      set age = age + 1
      if age > 150
        goto retry
      end
    end
  end
---
script prompt
step:
  if pressed("confirm")
    goto table
  end
---
script relay
step:
  if touch("ball")
    global relays = global(relays) + 1
    emit relay_flash
    destroy
  end
---
particle relay_flash {"count":25,"life":29,"speed":135.0,"radius":1.7,"color":[117,235,193,255]}
particle spark {"count":9,"life":16,"speed":76.0,"radius":1.4,"color":[255,191,92,255]}
