sprite cinder {"file":"art/cinder.png","frames":[[0,0,16,16],[16,0,16,16],[32,0,16,16],[48,0,16,16],[64,0,16,16],[80,0,16,16],[96,0,16,16],[112,0,16,16],[128,0,16,16],[144,0,16,16]]}
animation active {"sprite":"cinder","frames":[9],"fps":8}
animation idle {"sprite":"cinder","frames":[0,1],"fps":7}
animation relay {"sprite":"cinder","frames":[6,7,8],"fps":8,"mode":"ping_pong"}
animation shoot {"sprite":"cinder","frames":[2,3,4,5],"fps":20,"mode":"once"}
tilemap yard {"cell":16,"tiles":{"#":[[46,73,108,255],true],"+":[[27,49,77,255]],"-":[[21,34,56,255]],"x":[[32,56,82,255],true]},"rows":["######################","#....................#","#....................#","#--+--+--+--+--+--+--#","#....................#","#--+--+--+--+--+--+--#","#....................#","#..........xxx.......#","#....................#","#--+--+--+--+--+--+--#","#..........xxx.......#","#.....+++.....++.....#","#....................#","######################"]}
script bolt
create:
  set vx = -210
  after life, 100
step:
  if touch("pilot") || expired(life)
    destroy
  end
hit_x:
  destroy
---
script entry
step:
  if pressed("confirm")
    goto yard
  end
---
script gate
step:
  if global(relays) == 3
    if !opening
      set opening = 1
      emit surge
      sound ping
    end
    if touch("pilot")
      goto clear
    end
  end
create:
  set opening = 0
---
script gun
create:
  after fire, 38
step:
  if expired(fire)
    spawn bolt x - 8, y + 5
    after fire, 55
  end
---
script pilot
create:
  global hull = 3
  global relays = 0
  global charge = 16
step:
  move (down("right") - down("left")) * 120 * dt, (down("down") - down("up")) * 120 * dt
  if down("fire") && remaining(shot) == 0
    spawn pulse x + 16, y + 7
    animate shoot, true
    after shot, 16
  else
    if anim_done()
      animate idle
    end
  end
  global charge = 16 - remaining(shot)
  if remaining(shield) == 0 && touch("bolt")
    global hull = global(hull) - 1
    emit hit
    after shield, 30
    if global(hull) == 0
      goto lost
    end
  end
  if pressed("reset")
    goto yard
  end
---
script pulse
create:
  set vx = 240
  after life, 82
step:
  if expired(life)
    destroy
  end
hit_x:
  destroy
---
script relay
step:
  if !charged && touch("pulse")
    set charged = 1
    global relays = global(relays) + 1
    animate active
    sound ping
    emit surge
  end
create:
  set charged = 0
---
script restart
step:
  if pressed("confirm")
    goto yard
  end
---
audio ping {"file":"audio/relay.wav","gain":0.5}
audio theme {"file":"audio/cinder.wav","gain":0.27}
particle hit {"count":14,"life":22,"speed":87.0,"radius":1.3,"color":[255,111,122,255]}
particle surge {"count":16,"life":23,"speed":100.0,"radius":1.4,"color":[85,236,199,255]}
