tilemap dock {"cell":16,"atlas":"terrain","tiles":{"#":[0,true],"g":[1,true],"o":[2,false]},"rows":["................","................","################","#..#....#......#","#..#....#......#","#.......g......#","#...#...#......#","#.......#....#.#","#.......#......#","################","................"]}
tilemap relay {"cell":16,"atlas":"terrain","tiles":{"#":[0,true],"g":[1,true],"o":[2,false]},"rows":["................","................","################","#.......#..#...#","#....#..#..#...#","#....#..#..#...#","#....#..#......#","#.......g......#","#.......#......#","################","................"]}
script back
step:
  if pressed("confirm") || pressed("cancel")
    goto main
  end
---
script dispatch
step:
  if pressed("confirm")
    goto dock
  end
  if pressed("up") && global(unlocked) != 0
    goto relay
  end
---
script finish_dock
step:
  if touch("courier")
    global unlocked = 1
    global deliveries = global(deliveries) + 1
    save
    sound seal
    goto main
  end
---
script finish_relay
step:
  if touch("courier")
    global deliveries = global(deliveries) + 1
    save
    sound seal
    goto clear
  end
---
script gate_dock
create:
  if tile_is("dock", 8, 5, "o")
    animate plate_on
  end
step:
  if tile_solid("dock", 8, 5) && touch("courier")
    tile dock 8, 5, "o"
    animate plate_on
    emit sparks, x + 8, y + 8
    sound latch
  end
---
script gate_relay
create:
  if tile_is("relay", 8, 7, "o")
    animate plate_on
  end
step:
  if tile_solid("relay", 8, 7) && touch("courier")
    tile relay 8, 7, "o"
    animate plate_on
    emit sparks, x + 8, y + 8
    sound latch
  end
---
script walk
step:
  if pressed("cancel")
    goto main
  end
  if remaining(stride) == 0
    set dx = down("right") - down("left")
    set dy = down("down") - down("up")
    if dx != 0 || dy != 0
      if dx != 0
        flip dx < 0, false
        move 16 * dx, 0
      else
        move 0, 16 * dy
      end
      animate boots, true
      after stride, 5
    end
  end
---
