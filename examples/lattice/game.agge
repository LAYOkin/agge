object controller {"size":[16.0,16.0],"color":[255,255,255,255],"script":"board","hidden":true}
object lantern {"size":[32.0,32.0],"color":[255,255,255,255],"sprite":"lantern","script":"tile"}
object restart {"size":[16.0,16.0],"color":[255,255,255,255],"script":"restart","hidden":true}
object victory {"size":[32.0,32.0],"color":[255,255,255,255],"animation":"glow"}
sprite lantern {"pixel":"lantern","poses":["dim","lit","shimmer"]}
sprite mesh {"pixel":"mesh"}
animation dim {"sprite":"lantern","frames":[0],"fps":6}
animation glow {"sprite":"lantern","frames":[1,2,1,2,1],"fps":8,"holds":{"0":2}}
script board
fn col(px) = floor((px - 20) / 32)
fn row(py) = floor((py - 40) / 32)
fn inside(c,r) = c >= 0 && c < 3 && r >= 0 && r < 3
create:
  global lit = 0
  global moves = 0
step:
  global hit = 0
  if pressed("mouse_right") || pressed("confirm")
    goto main
  else
    if global(lit) == 0
      goto clear
    else
      if pressed("mouse_left")
        global target_col = col(pointer("x"))
        global target_row = row(pointer("y"))
        if inside(global(target_col), global(target_row))
          global hit = 1
          global moves = global(moves) + 1
        end
      end
    end
  end
---
script restart
step:
  if pressed("mouse_left") || pressed("confirm")
    goto main
  end
---
script tile
fn near(col,row,other_col,other_row) = abs(col - other_col) + abs(row - other_row) <= 1
create:
  set col = board.col(x)
  set row = board.row(y)
  set lit = near(col,row,1,1) != near(col,row,0,0)
  if lit
    global lit = global(lit) + 1
    animate glow
  end
step:
  if global(hit)
    set target_col = global(target_col)
    set target_row = global(target_row)
    if near(col,row,target_col,target_row)
      set lit = !lit
      global lit = global(lit) + 2 * lit - 1
      if lit
        animate glow, true
      else
        animate dim
      end
      if col == target_col && row == target_row
        emit cinders, x + 16, y + 16
      end
    end
  end
---
