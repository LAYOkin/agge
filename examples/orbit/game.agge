object core {"size":[14.0,14.0],"color":[250,207,119,255],"shape":"circle","script":"collect"}
object drone {"size":[24.0,18.0],"color":[255,111,145,255],"shape":"circle","script":"patrol"}
object prompt {"size":[16.0,16.0],"color":[255,255,255,255],"script":"restart","hidden":true}
object ship {"size":[18.0,18.0],"color":[255,255,255,255],"animation":"thrust","script":"drive"}
sprite ship {"file":"art/ship.png","frames":[[0,0,16,16],[16,0,16,16]]}
sprite terrain {"file":"art/terrain.png","frames":[[0,0,16,16],[16,0,16,16]]}
animation thrust {"sprite":"ship","frames":[0,1],"fps":9}
tilemap station {"cell":16,"atlas":"terrain","tiles":{"#":[0,true],"+":[1,false]},"rows":["##############################","#............................#","#..+..+..+..+..+..+..+..+....#","#............................#","#..................######....#","#............................#","#............................#","#....#######.................#","#............................#","#............................#","#........................###.#","#..+..+..+..+..+..+..+..+....#","#.....#######................#","#............................#","#............................#","#..+..+..+..+..+..+..+..+....#","#............................#","##############################"]}
script collect
step:
  if touch("ship")
    global score = global(score) + 1
    emit pulse
    sound collect
    destroy
  end
---
script drive
create:
  global score = 0
step:
  move motion.axis(down("left"), down("right"), 120), motion.axis(down("up"), down("down"), 120)
  if touch("drone")
    goto retry
  else
    if global(score) == 3
      goto clear
    end
  end
---
script motion
fn axis(negative, positive, speed) = (positive - negative) * speed * dt
---
script patrol
create:
  set vx = 90
step:
  if x >= 408
    set vx = -90
  end
  if x <= 192
    set vx = 90
  end
---
script restart
step:
  if pressed("confirm")
    goto station
  end
---
audio collect {"file":"audio/collect.wav","gain":0.65}
particle pulse {"count":22,"life":55,"speed":95.0,"radius":2.0,"color":[250,207,119,255]}
