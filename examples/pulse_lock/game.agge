object gate {"size":[20.0,42.0],"color":[53,69,104,255]}
object pulse {"size":[12.0,12.0],"color":[255,195,131,255],"shape":"circle","script":"lock","depth":1}
object restart {"size":[16.0,16.0],"color":[255,255,255,255],"script":"restart","hidden":true}
object target {"size":[20.0,4.0],"color":[142,232,232,255],"script":"indicator"}
object track {"size":[416.0,4.0],"color":[49,60,87,255]}
script indicator
step:
  set x = lock.gate(global(locks)) - 10
---
script lock
fn gate(stage) = 132 + 116 * stage
create:
  set direction = 1
  global locks = 0
  global misses = 0
step:
  if x >= 432
    set direction = -1
  end
  if x <= 36
    set direction = 1
  end
  move direction * 240 * dt, 0
  if pressed("lock")
    if direction == 1 && abs(x + 6 - gate(global(locks))) <= 10
      global locks = global(locks) + 1
      emit spark
      if global(locks) == 3
        goto clear
      end
    else
      global locks = 0
      global misses = global(misses) + 1
    end
  end
---
script restart
step:
  if pressed("confirm")
    goto main
  end
---
particle spark {"count":8,"life":16,"speed":60.0,"radius":1.5,"color":[142,232,232,255]}
