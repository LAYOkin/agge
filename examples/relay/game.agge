tilemap road {"cell":16,"tiles":{"#":[[45,73,99,255],true],"+":[[42,83,117,255]],"=":[[27,42,59,255]]},"rows":["############################################################","#.+.....+.....+.....+.....+.....+.....+.....+.....+.....+..#","#..........................................................#","#.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=..#","#...................##...............##....................#","#...........+.......##.....+.........##...+............+...#","#...................##...............##....................#","#..........................................................#","#.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=.=..#","#..........................................................#","#.+.....+.....+.....+.....+.....+.....+.....+.....+.....+..#","############################################################"]}
script collect
step:
  if touch("courier")
    global relays = global(relays) + 1
    emit signal
    destroy
  end
---
script drive
create:
  global relays = 0
step:
  move (down("right") - down("left")) * 120 * dt, (down("down") - down("up")) * 120 * dt
  if global(relays) == 3 && touch("gate")
    goto clear
  end
---
script restart
step:
  if pressed("confirm")
    goto road
  end
---
particle signal {"count":20,"life":30,"speed":70.0,"radius":1.5,"color":[252,206,113,255]}
