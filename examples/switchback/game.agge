tilemap shaft {"cell":16,"tiles":{"#":[[50,68,104,255],true],"+":[[25,35,62,255]],"-":[[30,41,66,255]]},"rows":["#......................................#","#......................................#","#.+....+....+....+....+....+....+....+.#","#......................................#","#......................................#","#......................................#","#.+....+....+....+....+....+....+....+.#","#......................................#","#......................................#","#......................................#","#.+....+....+....+....+....+....+....+.#","#......................................#","#......................................#","#......................................#","#.+....+....+....+....+....+....+....+.#","#......................................#","#.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-#","#......................................#","########################################","########################################"]}
script collect
step:
  if touch("courier")
    global chips = global(chips) + 1
    emit glint
    destroy
  end
---
script drive
create:
  global chips = 0
step:
  move (down("right") - down("left")) * 120 * dt, 0
  if grounded() && (pressed("fire") || pressed("up"))
    set vy = -255
  end
---
script lift
step:
  if global(chips) == 2 && touch("courier")
    goto clear
  end
---
script restart
step:
  if pressed("confirm")
    goto shaft
  end
---
particle glint {"count":16,"life":26,"speed":76.0,"radius":1.5,"color":[253,205,116,255]}
